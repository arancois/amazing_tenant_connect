// Consumption View : ZC_RE_ObjectAssignment (exposed - Lease Unit)
// (+) Insert by [PERNR-REDACTED] dated 12.06.2026 for CR_123
@AccessControl.authorizationCheck: #CHECK
@EndUserText.label: 'RE Contract API - Object Assignment'
@Metadata.allowExtensions: true
define view entity ZC_RE_ObjectAssignment
  as projection on ZI_RE_ObjectAssignment
{
  key InternalRENumber,
  key ContractObjectNumber,
  key RentalObjectObjectNumber,
  key AssignmentValidFrom,
      ContractNumber,
      CompanyCode,
      ProjectNumber,
      RentalObjectNumber,
      UnitId,
      CommencementDate,
      EndDate,
      TerminationDate,
      _Contract : redirected to ZC_RE_Contract
}
