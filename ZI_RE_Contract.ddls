// =====================================================================
// Interface View : ZI_RE_Contract   (ROOT)
// Source tables  : VICNCN (RE Contract) + JEST (system status) for the
//                  deletion-status derivation.
// Filters [FS §1.1]:
//   * RECNNR LIKE 'C%'                      (contract no starts with 'C')
//   * RECNTYPE NOT IN (Z100, Z320, Z220)    (exclude deposit / non-RE /
//                                            property-tax contracts)
// Derived [FS §2.5]:
//   * DeletionStatus : 'D' when system status I0076 is active on the
//                      contract object, else 'A'
//   * SalesCollectInd: 'Y' when SRRELEVANT = 'X', else 'N'
// VDM type       : Basic Interface View (root) | Tier 2
// Clean core (F-03): VICNCN and JEST are read directly (RE-FX cluster +
//   status). No released CDS replacement is generally available on-prem,
//   so Tier-3 access is consciously accepted and documented here.
// (+) Insert by [PERNR-REDACTED] dated 12.06.2026 for CR_123
// (+) Update by [PERNR-REDACTED] dated 12.06.2026 for CR_123 —
//     added _ObjectAssignment, _LeasePerform, _ContractClass,
//     _ContractCategory navigations for the extended API surface.
// =====================================================================
@AccessControl.authorizationCheck: #CHECK
@EndUserText.label: 'RE Interface - Contract (Root)'
@Metadata.ignorePropagatedAnnotations: true
@ObjectModel.usageType: { serviceQuality: #C, sizeCategory: #L, dataClass: #TRANSACTIONAL }
define root view entity ZI_RE_Contract
  as select from vicncn as Contract

  left outer to one join jest as DelStatus
    on  DelStatus.objnr = Contract.objnr
    and DelStatus.stat  = 'I0076'
    and DelStatus.inact = ' '

  association [0..*] to ZI_RE_BPRelation      as _BPRelation
    on $projection.InternalRENumber = _BPRelation.InternalRENumber
  association [0..*] to ZI_RE_RentalObject    as _RentalObject
    on $projection.ObjectNumber = _RentalObject.ContractObjectNumber
  association [0..1] to ZI_RE_BusinessEntity  as _BusinessEntity
    on  $projection.CompanyCode          = _BusinessEntity.CompanyCode
    and $projection.BusinessEntityNumber = _BusinessEntity.ProjectNumber
  association [0..1] to ZI_RE_Company         as _Company
    on $projection.CompanyCode = _Company.CompanyCode
  association [0..*] to ZI_RE_ObjectAssignment as _ObjectAssignment
    on $projection.ObjectNumber = _ObjectAssignment.ContractObjectNumber
  association [0..*] to ZI_RE_LeasePerform     as _LeasePerform
    on $projection.InternalRENumber = _LeasePerform.InternalRENumber
  association [0..1] to ZI_RE_ContractClass    as _ContractClass
    on $projection.ContractClass = _ContractClass.ClassCode
  association [0..1] to ZI_RE_ContractCategory as _ContractCategory
    on $projection.ContractCategory = _ContractCategory.CategoryCode
{
  key Contract.intreno                       as InternalRENumber,
      Contract.objnr                         as ObjectNumber,
      Contract.recnnr                        as ContractNumber,
      Contract.recnnrcollect                 as MainContractNumber,
      Contract.bukrs                         as CompanyCode,
      Contract.benocn                        as BusinessEntityNumber,
      Contract.recntxtold                    as ReferenceNumber,
      Contract.recntxt                       as ContractName,
      Contract.recntype                      as ContractType,
      Contract.zzclass                       as ContractClass,
      Contract.zzcategory                    as ContractCategory,
      Contract.recnbeg                       as CommencementDate,
      Contract.recnend1st                    as ExpiryDate,
      Contract.recnendabs                    as AbsoluteEndDate,
      Contract.recnnotper                    as TerminationDate,
      Contract.srrelevant                    as SalesRelevant,

      case when DelStatus.objnr is not null
           then 'D' else 'A' end             as DeletionStatus,
      case when Contract.srrelevant = 'X'
           then 'Y' else 'N' end             as SalesCollectInd,

      _BPRelation,
      _RentalObject,
      _BusinessEntity,
      _Company,
      _ObjectAssignment,
      _LeasePerform,
      _ContractClass,
      _ContractCategory
}
where  Contract.recnnr   like 'C%'
  and  Contract.recntype not in ( 'Z100', 'Z320', 'Z220' )
