// =====================================================================
// Interface View : ZI_RE_ContractClass
// Source table   : DD07T (domain fixed-value text)         [FS file 6]
// Purpose        : Expose fixed values of domain ZRECNCLASS (the FS
//                  reads them via GET_DOMAIN_VALUES in the batch job;
//                  for the API they are surfaced as a lookup entity).
// Filter         : DOMNAME = 'ZRECNCLASS', active, English
// VDM type       : Basic Interface View   | Tier 3 (DDIC internals)
// Clean-core flag (F-03): DD07T is an unreleased DDIC table. Released
//   alternative: model on the check table if the domain becomes
//   value-table backed. Tier-3 accepted for this read-only lookup.
// (+) Insert by [PERNR-REDACTED] dated 12.06.2026 for CR_123
// =====================================================================
@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'RE Interface - Contract Class'
@Metadata.ignorePropagatedAnnotations: true
@VDM.viewType: #BASIC
@ObjectModel.usageType: { serviceQuality: #D, sizeCategory: #S, dataClass: #CUSTOMIZING }
define view entity ZI_RE_ContractClass
  as select from dd07t
{
  key cast( domvalue_l as abap.char( 4 ) ) as ClassCode,
      ddtext                               as Description
}
where domname    = 'ZRECNCLASS'
  and as4local   = 'A'
  and ddlanguage = 'E'
