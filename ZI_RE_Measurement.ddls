// =====================================================================
// Interface View : ZI_RE_Measurement
// Source tables  : VIBDMEAS (Measurement) joined to VIBDRO on INTRENO
// Filter         : Measurement type MEAS = 'Y20', unit MEASUNIT = 'M2'
//                  Rental object usage type SNUNR < 5000  [FS §1.1, item 4]
// VDM type       : Basic Interface View   | Tier 2
// (+) Insert by [PERNR-REDACTED] dated 12.06.2026 for CR_123
// =====================================================================
@AccessControl.authorizationCheck: #CHECK
@EndUserText.label: 'RE Interface - Measurement'
@Metadata.ignorePropagatedAnnotations: true
@VDM.viewType: #BASIC
@ObjectModel.usageType: { serviceQuality: #C, sizeCategory: #M, dataClass: #TRANSACTIONAL }
define view entity ZI_RE_Measurement
  as select distinct from vibdmeas as Meas
    inner join vibdro as RentalObject
      on RentalObject.intreno = Meas.intreno
{
  key Meas.intreno                  as InternalRENumber,
  key Meas.meas                     as MeasurementType,
  key Meas.validfrom                as ValidFrom,
      Meas.validto                  as ValidTo,
      RentalObject.bukrs            as CompanyCode,
      RentalObject.swenr            as ProjectNumber,
      RentalObject.smenr            as RentalObjectNumber,
      @Semantics.quantity.unitOfMeasure: 'MeasurementUnit'
      Meas.measvalue                as FloorArea,
      Meas.measunit                 as MeasurementUnit
}
where Meas.meas     = 'Y20'
  and Meas.measunit = 'M2'
  and RentalObject.snunr < '5000'
