@AccessControl.authorizationCheck: #CHECK
@EndUserText.label: 'RE Contract API - Lease Perform'
@Metadata.allowExtensions: true
define view entity ZC_RE_LeasePerform
  as projection on ZI_RE_LeasePerform
{
  key InternalRENumber,
  key BusinessPartner,
  key BPRole,
      ContractNumber,
      CompanyCode,
      BusinessEntityNumber,
      CommencementDate,
      ExpiryDate,
      Frequency,
      PerformValue,
      _Contract : redirected to ZC_RE_Contract
}
