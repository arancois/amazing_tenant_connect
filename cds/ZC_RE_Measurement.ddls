@AccessControl.authorizationCheck: #CHECK
@EndUserText.label: 'RE Contract API - Measurement'
@Metadata.allowExtensions: true
define view entity ZC_RE_Measurement
  as projection on ZI_RE_Measurement
{
  key InternalRENumber,
  key MeasurementType,
  key ValidFrom,
      ValidTo,
      CompanyCode,
      ProjectNumber,
      RentalObjectNumber,
      @Semantics.quantity.unitOfMeasure: 'MeasurementUnit'
      FloorArea,
      MeasurementUnit
}
