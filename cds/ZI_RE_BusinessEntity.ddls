@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'RE Interface - Business Entity'
@Metadata.ignorePropagatedAnnotations: true
@VDM.viewType: #BASIC
@ObjectModel.usageType: { serviceQuality: #C, sizeCategory: #S, dataClass: #MASTER }
define view entity ZI_RE_BusinessEntity
  as select from vibdbe
{
  key bukrs   as CompanyCode,
  key swenr   as ProjectNumber,
      xwetext as Description
}
