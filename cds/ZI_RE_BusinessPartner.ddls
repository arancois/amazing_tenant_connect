// =====================================================================
// Interface View : ZI_RE_BusinessPartner
// Source table   : BUT000 (Business Partner: General Data)
// FS mapping      : BusinessName = NAME_GRP1 + NAME_GRP2 (truncate 60)
// VDM type       : Basic Interface View   | Tier 2
// (+) Insert by [PERNR-REDACTED] dated 12.06.2026 for CR_123
// =====================================================================
@AccessControl.authorizationCheck: #CHECK
@EndUserText.label: 'RE Interface - Business Partner'
@Metadata.ignorePropagatedAnnotations: true
@VDM.viewType: #BASIC
@ObjectModel.usageType: { serviceQuality: #C, sizeCategory: #S, dataClass: #MASTER }
define view entity ZI_RE_BusinessPartner
  as select from but000
{
  key partner                                              as BusinessPartner,
      type                                                 as BusinessPartnerType,
      // FS §2.5: NAME_GRP1 + NAME_GRP2, downstream truncates to 60 chars
      substring( concat_with_space( name_grp1, name_grp2, 1 ), 1, 60 ) as BusinessName,
      name_grp1                                            as NameGroup1,
      name_grp2                                            as NameGroup2
}
