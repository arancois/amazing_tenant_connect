// =====================================================================
// Interface View : ZI_RE_ContractTheme
// Source table   : DD07T (domain fixed-value text)         [FS file 8]
// Purpose        : Expose fixed values of the contract THEME domain.
// TODO confirm domain (F-02): FS §1.1 item 8 reads 'ZRECNCAT' for Theme,
//   which is the SAME domain as Category — almost certainly an FS
//   copy-paste error. Modelled here against a placeholder 'ZRECNTHEME'.
//   >>> CONFIRM the correct theme domain with the functional team and
//   >>> adjust DOMNAME below before activation. <<<
// VDM type       : Basic Interface View   | Tier 3 (DDIC internals)
// (+) Insert by [PERNR-REDACTED] dated 12.06.2026 for CR_123
// =====================================================================
@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'RE Interface - Contract Theme'
@Metadata.ignorePropagatedAnnotations: true
@VDM.viewType: #BASIC
@ObjectModel.usageType: { serviceQuality: #D, sizeCategory: #S, dataClass: #CUSTOMIZING }
define view entity ZI_RE_ContractTheme
  as select from dd07t
{
  key cast( domvalue_l as abap.char( 4 ) ) as ThemeCode,
      ddtext                               as Description
}
where domname    = 'ZRECNTHEME'
  and as4local   = 'A'
  and ddlanguage = 'E'
