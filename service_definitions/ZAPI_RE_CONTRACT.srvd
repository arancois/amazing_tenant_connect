// =====================================================================
// Service Definition : ZAPI_RE_CONTRACT
// Outbound RE contract data API for third-party consumption (CR_123).
// Named ZAPI_ (Web API), not ZUI_ — this is a system-to-system API,
// not a Fiori UI service.  Read-only (no behaviour definitions).
// (+) Insert by [PERNR-REDACTED] dated 12.06.2026 for CR_123
// (+) Update by [PERNR-REDACTED] dated 12.06.2026 for CR_123 —
//     exposed ObjectAssignment, PartOfBuilding, LeasePerform,
//     ContractClass, ContractCategory, ContractTheme to complete the
//     FS data scope (12 datasets).
// =====================================================================
@EndUserText.label: 'RE Contract Outbound API (CR_123)'
define service ZAPI_RE_CONTRACT {
  expose ZC_RE_Contract         as Contract;
  expose ZC_RE_BPRelation       as BPRelation;
  expose ZC_RE_BusinessPartner  as BusinessPartner;
  expose ZC_RE_RentalObject     as RentalObject;
  expose ZC_RE_Measurement      as Measurement;
  expose ZC_RE_Company          as Company;
  expose ZC_RE_BusinessEntity   as BusinessEntity;
  // ---- (+) added for CR_123 extended scope ------------------------
  expose ZC_RE_ObjectAssignment as ObjectAssignment;
  expose ZC_RE_PartOfBuilding   as PartOfBuilding;
  expose ZC_RE_LeasePerform     as LeasePerform;
  expose ZC_RE_ContractClass    as ContractClass;
  expose ZC_RE_ContractCategory as ContractCategory;
  expose ZC_RE_ContractTheme    as ContractTheme;
}
